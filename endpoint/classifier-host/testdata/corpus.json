{
  "name": "classifier-equivalence-v1",
  "budget_ms": 2000,
  "cases": [
    {
      "id": "pan-valid-luhn",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "Please charge card 4111 1111 1111 1111 for the invoice.",
      "expect": { "confidence": "high", "classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "pan-invalid-luhn",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "Reference 4111 1111 1111 1112 is a serial number, not a card.",
      "expect": { "confidence": "high", "absent_classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "pan-documentation-example",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "test card 4111 1111 1111 1111 appears in the manual.",
      "expect": { "confidence": "high", "absent_classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "ssn-valid-structure",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "Employee SSN 123-45-6789 is on file.",
      "expect": { "confidence": "high", "classes": ["government_id"], "degraded": false }
    },
    {
      "id": "ssn-reserved-area",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "Sample 000-12-3456 was never issued.",
      "expect": { "confidence": "high", "absent_classes": ["government_id"], "degraded": false }
    },
    {
      "id": "iban-valid-mod97",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "Settlement account GB82WEST12345698765432 is verified.",
      "expect": { "confidence": "high", "classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "iban-invalid-check",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "Settlement account GB82WEST12345698765433 is unverified.",
      "expect": { "confidence": "high", "absent_classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "credential-aws-key",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "export AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE",
      "expect": { "confidence": "high", "classes": ["credential"], "degraded": false }
    },
    {
      "id": "credential-private-key",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA\n-----END RSA PRIVATE KEY-----",
      "expect": { "confidence": "high", "classes": ["credential"], "degraded": false }
    },
    {
      "id": "source-go-declaration",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "package main\n\nfunc main() {\n\tprintln(\"hello\")\n}",
      "expect": { "confidence": "high", "classes": ["source_code"], "degraded": false }
    },
    {
      "id": "legal-clause",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "WHEREAS the parties agree that the liability of each party shall be limited by clause 7.",
      "expect": { "confidence": "high", "classes": ["legal"], "degraded": false }
    },
    {
      "id": "health-model-only",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "The icd-10 code was recorded after the physician reviewed the dosage.",
      "expect": { "classes": ["health"], "degraded": false }
    },
    {
      "id": "no-findings",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "The weather in Lisbon is mild in October.",
      "expect": { "confidence": "high", "degraded": false }
    },
    {
      "id": "unicode-fullwidth-pan",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "カード番号は４１１１　１１１１　１１１１　１１１１です。",
      "expect": { "confidence": "high", "classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "json-prompt-extraction",
      "mode": "m1",
      "media_type": "application/json",
      "content": "{\"messages\":[{\"role\":\"user\",\"content\":\"my card is 4111 1111 1111 1111\"}],\"temperature\":0.7}",
      "expect": { "confidence": "high", "classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "json-deep-nesting",
      "mode": "m1",
      "media_type": "application/json",
      "content": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[\"too deep\"]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
      "expect": { "degraded": true }
    },
    {
      "id": "m2-excerpt",
      "mode": "m2",
      "media_type": "text/plain",
      "content": "Charge card 4111 1111 1111 1111 today.",
      "expect": { "confidence": "high", "classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "m3-no-excerpt",
      "mode": "m3",
      "media_type": "text/plain",
      "content": "Charge card 4111 1111 1111 1111 today.",
      "expect": { "confidence": "high", "classes": ["payment_card"], "degraded": false }
    },
    {
      "id": "m0-content-refused",
      "mode": "m0",
      "media_type": "text/plain",
      "content": "4111 1111 1111 1111 must never reach the classifier at M0",
      "expect": { "degraded": true }
    },
    {
      "id": "large-body-fully-processed",
      "mode": "m1",
      "media_type": "text/plain",
      "content": "filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler filler card on file 4111 1111 1111 1111 and nothing else of note in this body",
      "expect": { "confidence": "high", "classes": ["payment_card"], "degraded": false }
    }
  ]
}
