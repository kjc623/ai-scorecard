# generated by installer/render.mjs from installer/manifest.mjs - edit the manifest, not this file
# ShadowAICapture.tenant.env - the tenant package file (docs/05-platform-delivery.md §6.1).
# control-api writes one per package download, beside the generic installer; the installer
# copies it to the tenant.env the agent reads after its vendor-wide file. Nothing else
# tenant-specific is in a package. The deployment key is minted per download and is secret.
SAC_TENANT_ID=00000000-0000-0000-0000-000000000000
SAC_DEVICE_ENDPOINT=https://devices.<region>.example.com
SAC_DEPLOYMENT_KEY=
SAC_AUTH_MODE=dpop
