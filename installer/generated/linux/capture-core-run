#!/bin/sh
# generated by installer/render.mjs from installer/manifest.mjs - edit the manifest, not this file
# Exec capture-core with the vendor file, then the tenant file (the later --config-file wins).
set -eu

CONFIG="${SAC_CONFIG_FILE:-/etc/shadow-ai-capture/capture-core.env}"
TENANT="${SAC_TENANT_FILE:-/etc/shadow-ai-capture/tenant.env}"
if [ ! -f "$CONFIG" ]; then
  echo "capture-core-run: configuration file $CONFIG not found" >&2
  exit 1
fi

BIN="${SAC_BINDIR:-/opt/shadow-ai-capture/bin}/capture-core"
if [ ! -x "$BIN" ]; then
  echo "capture-core-run: $BIN is missing or not executable" >&2
  exit 1
fi

if [ -f "$TENANT" ]; then
  exec "$BIN" --config-file "$CONFIG" --config-file "$TENANT"
fi
exec "$BIN" --config-file "$CONFIG"
