# generated by installer/render.mjs from installer/manifest.mjs - edit the manifest, not this file
# Shadow AI Capture 0.1.0 - endpoint configuration template

# This is a TEMPLATE. The customer's MDM writes the real values (the enrolment
# profile of docs/05-platform-delivery.md §6.2): the regional device FQDN, the
# credential mode, the pinned CA set, and a short-lived single-use enrolment token.
# The installer does not put tenant values in the artefact.

# tenant stamped on every envelope (from enrolment, docs/01 §13.1)
SAC_TENANT_ID=
# device stamped on every envelope; must match the issued credential
SAC_DEVICE_ID=
# pseudonymous subject reference, never a name or e-mail
SAC_USER_REF=device-user
# clear machine name; empty resolves the OS hostname (ADR 0021)
SAC_HOSTNAME=
# clear account name on each submission; empty resolves the OS user (ADR 0021)
SAC_SUBJECT_NAME=
# whether the device is under MDM; no resolver in this build, so it is the agent report
SAC_MANAGED_STATE=unknown
# tenant identity setting to act on; 'hashed' sends no clear hostname or name (ADR 0021)
SAC_DEVICE_IDENTITY=clear
# user population for scope resolution (may be empty)
SAC_POPULATION=
# the agent's only durable store; opened before any provider starts
SAC_SPOOL_DIR=/var/lib/shadow-ai-capture/spool
# spool key file; must be OUTSIDE the spool directory
SAC_SPOOL_KEY=/var/lib/shadow-ai-capture/spool.key
# spool bound profile; dev is small so drop-oldest is reachable
SAC_SPOOL_BOUNDS=default
# device-side retention for spooled observations
SAC_RETENTION=720h
# append the health channel to this file as JSON lines; empty disables it
SAC_HEALTH_FILE=/var/lib/shadow-ai-capture/health.jsonl
# signed policy bundle; empty runs at M0 (metadata only)
SAC_BUNDLE=
# hex-encoded Ed25519 public key the bundle must verify under
SAC_POLICY_KEY=
# key id the bundle must name
SAC_POLICY_KEY_ID=policy-key-1
# transport:path of the classifier host; empty means rules-only
SAC_CLASSIFIER_ADDRESS=
# budget for one classification
SAC_CLASSIFIER_BUDGET=2s
# signed classifier release directory; with no SAC_CLASSIFIER_ADDRESS the agent runs the installed classifier-host as a child
SAC_CLASSIFIER_RELEASE=
# hex-encoded Ed25519 public key the classifier release must verify under
SAC_CLASSIFIER_PUBKEY=
# M3 local content store; empty means the device holds no content and refuses M3 observations
SAC_CONTENT_DIR=
# key file the content store is sealed under; must be OUTSIDE SAC_CONTENT_DIR
SAC_CONTENT_KEY=
# run proxy.tls (the egress interceptor)
SAC_PROXY_TLS=true
# proxy.tls listen address
SAC_PROXY_TLS_LISTEN=127.0.0.1:0
# canary host:port for the end-to-end probe; empty reports degraded
SAC_PROXY_TLS_CANARY=
# run proxy.loopback using the bundle's port map
SAC_PROXY_LOOPBACK=true
# run proc.detect (needs an enumerator)
SAC_PROC_DETECT=false
# bounded spool drain at shutdown
SAC_DRAIN_DEADLINE=30s
# policy cap for one attachment manifest, checked before any byte moves
SAC_ATTACHMENT_CAP=67108864
# install the per-device root CA into the platform trust store
SAC_TRUST_INSTALL=false
# Windows trust store; other platforms ignore it
SAC_TRUST_STORE=root
# remove the root CA on shutdown (uninstall or kill switch)
SAC_TRUST_REMOVE_ON_STOP=false
# per-device CA private key PEM (0600); empty generates an ephemeral CA
SAC_CA_KEY=
# per-device CA public cert PEM; empty uses the bundle's interception.root_ca_pem
SAC_CA_CERT=
# run cli.shim (managed shell trust/proxy environment for CLI runtimes)
SAC_CLI_SHIM=false
# directory cli.shim writes the CA bundle and profile into; empty uses a platform default
SAC_SHIM_DIR=
# device ingress base URL, e.g. https://ingest.eu.example.com; empty disables the drain
SAC_DEVICE_ENDPOINT=
# device credential mode for the drain
SAC_AUTH_MODE=
# sealed device credential issued by POST /v1/enrol; must NOT be inside SAC_SPOOL_DIR
SAC_CREDENTIAL_FILE=/var/lib/shadow-ai-capture/credential.sealed
# single-use bootstrap token from the MDM enrolment profile
SAC_ENROLMENT_TOKEN=
# PEM CA set the edge is pinned to; empty uses the system roots
SAC_CA_FILE=
# MDM-delivered device identifier; the preferred hardware-identity seed
SAC_MDM_ID=
# drain retry backoff base (full jitter)
SAC_BACKOFF_BASE=1s
# drain retry backoff cap
SAC_BACKOFF_CAP=300s
# log level
SAC_LOG_LEVEL=info
# log format
SAC_LOG_FORMAT=json
