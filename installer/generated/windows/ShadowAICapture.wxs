<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by installer/render.mjs from installer/manifest.mjs - edit the manifest, not this file -->
<!--
  Development MSI source (docs/05-platform-delivery.md section 6.1). It installs the binaries, the
  console wrapper, the enrolment profile (capture-core.env) and the files that profile points at
  (the staged profile directory: signed policy bundle, device CA, classifier release, pinned
  edge CA). The Windows service runs capture-core in service mode and reads that file through
  the config-file flag, so no command line is built from the profile and a path or secret with
  spaces needs no quoting. (An XML comment cannot contain a double hyphen; keep it out of
  comments here.)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Shadow AI Capture" Manufacturer="Shadow AI Capture"
           Version="0.1.0" UpgradeCode="7E9C2B7A-6D0E-4C6A-9F2B-1A6E6C2D44A1"
           Scope="perMachine" Compressed="yes">
    <!-- A rebuilt development MSI carries the same version, and it must replace the installed
         one rather than register a second product beside it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Shadow AI Capture is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ShadowAICapture">
        <Directory Id="BINFOLDER" Name="bin" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CONFIGFOLDER" Name="ShadowAICapture">
        <Directory Id="PROFILEFOLDER" Name="profile" />
        <Directory Id="STATEFOLDER" Name="state" />
        <Directory Id="LOGFOLDER" Name="log" />
      </Directory>
    </StandardDirectory>

    <DirectoryRef Id="BINFOLDER">
      <Component Id="Cmp_classifier_host" Directory="BINFOLDER" Guid="*">
        <File Id="Fil_classifier_host" Source="$(var.StageDir)\bin\classifier-host.exe" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_capture_core_run" Directory="BINFOLDER" Guid="*">
        <File Id="Fil_capture_core_run" Source="$(var.StageDir)\bin\capture-core-run.cmd" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_Service" Directory="BINFOLDER" Guid="*">
        <File Id="Fil_ServiceExe" Source="$(var.StageDir)\bin\capture-core.exe" KeyPath="yes" />
        <ServiceInstall Id="SvcCaptureCore" Name="ShadowAICapture" DisplayName="Shadow AI Capture"
                        Description="Observes AI submissions on this device and drains them to the tenant ingress."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                        Arguments="--service --service-name ShadowAICapture --config-file C:\ProgramData\ShadowAICapture\capture-core.env" />
        <!-- ServiceControl does not start the service: a start it waited on and that failed would
             abort the whole install transaction and roll the files back, leaving nothing to
             diagnose. CaStartService below starts it instead, and ignores the outcome. -->
        <ServiceControl Id="SvcCaptureCoreControl" Name="ShadowAICapture" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="CONFIGFOLDER">
      <Component Id="Cmp_capture_core_config" Directory="CONFIGFOLDER" Guid="*">
        <File Id="Fil_capture_core_config" Source="$(var.StageDir)\etc\capture-core.env" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <!-- Whatever Build-Msi.ps1 staged as the profile directory, tree preserved. -->
    <ComponentGroup Id="ProfileFiles" Directory="PROFILEFOLDER">
      <Files Include="$(var.StageDir)\profile\**" />
    </ComponentGroup>

    <!-- Output goes to nul and the action is not waited for. sc.exe run bare from a custom
         action was seen to start the service and then block for good on its own console
         output, which held the installer open; the install is complete once the service is
         registered, so nothing here may wait on a console. -->
    <CustomAction Id="CaStartService" Directory="CommonAppDataFolder" Execute="deferred" Impersonate="no" Return="asyncNoWait"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c sc.exe start ShadowAICapture &gt;nul 2&gt;&amp;1" />
    <!-- A full uninstall leaves nothing behind: the spool, the sealed credential and the logs are
         written by the agent, not installed, so Windows Installer would otherwise keep them. An
         upgrade keeps them, because an installer that resets a device identity is worse than
         one that stops. -->
    <CustomAction Id="CaRemoveData" Directory="CommonAppDataFolder" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;[CONFIGFOLDER]&quot;" />
    <?ifdef FreshEnrolment ?>
    <!-- This build carries a new single-use enrolment token for a server that does not know the
         credential an earlier install sealed, so the device must enrol again. -->
    <CustomAction Id="CaResetState" Directory="CommonAppDataFolder" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;[STATEFOLDER]&quot;" />
    <?endif?>
    <InstallExecuteSequence>
      <?ifdef FreshEnrolment ?>
      <Custom Action="CaResetState" After="StopServices" Condition="NOT REMOVE" />
      <?endif?>
      <Custom Action="CaStartService" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="CaRemoveData" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Shadow AI Capture" Level="1">
      <ComponentRef Id="Cmp_Service" />
      <ComponentRef Id="Cmp_classifier_host" />
      <ComponentRef Id="Cmp_capture_core_run" />
      <ComponentRef Id="Cmp_capture_core_config" />
      <ComponentGroupRef Id="ProfileFiles" />
    </Feature>
  </Package>
</Wix>
