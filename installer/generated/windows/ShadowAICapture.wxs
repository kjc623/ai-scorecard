<!--
  Development MSI source (docs/05-platform-delivery.md §6.1). It carries code only; the
  per-tenant enrolment profile is delivered by the customer's MDM. The service argv is the
  public property SAC_ARGS, so Intune can pass it on the msiexec command line:

    msiexec /i ShadowAICapture.msi /qn SAC_ARGS="--tenant-id ... --device-endpoint https://..."

  Build-Msi.ps1 composes a SAC_ARGS default from a config file for a development MSI.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Shadow AI Capture" Manufacturer="Shadow AI Capture"
           Version="0.1.0" UpgradeCode="7E9C2B7A-6D0E-4C6A-9F2B-1A6E6C2D44A1"
           Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Shadow AI Capture is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- The whole device argv, composed from a config file by Build-Msi.ps1 and overridable at install. -->
    <Property Id="SAC_ARGS" Value="$(var.SacArgs)" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ShadowAICapture">
        <Directory Id="BINFOLDER" Name="bin" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CONFIGFOLDER" Name="ShadowAICapture">
        <Directory Id="STATEFOLDER" Name="state" />
        <Directory Id="LOGFOLDER" Name="log" />
      </Directory>
    </StandardDirectory>

    <DirectoryRef Id="BINFOLDER">
      <Component Id="Cmp_capture_core" Directory="INSTALLFOLDER" Guid="*">
        <File Id="Fil_capture_core" Source="$(var.StageDir)\bin\capture-core.exe" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_classifier_host" Directory="INSTALLFOLDER" Guid="*">
        <File Id="Fil_classifier_host" Source="$(var.StageDir)\bin\classifier-host.exe" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_capture_core_run" Directory="INSTALLFOLDER" Guid="*">
        <File Id="Fil_capture_core_run" Source="$(var.StageDir)\bin\capture-core-run.exe" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_capture_core_env_example" Directory="CONFIGFOLDER" Guid="*">
        <File Id="Fil_capture_core_env_example" Source="$(var.StageDir)\bin\capture-core.env.example" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_Service" Directory="BINFOLDER" Guid="*">
        <File Id="Fil_ServiceExe" Source="$(var.StageDir)\bin\capture-core.exe" KeyPath="yes" />
        <ServiceInstall Id="SvcCaptureCore" Name="ShadowAICapture" DisplayName="Shadow AI Capture"
                        Description="Observes AI submissions on this device and drains them to the tenant ingress."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                        Arguments="[SAC_ARGS]" />
        <ServiceControl Id="SvcCaptureCoreControl" Name="ShadowAICapture" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Shadow AI Capture" Level="1">
      <ComponentRef Id="Cmp_Service" />
      <ComponentRef Id="Cmp_capture_core" />
      <ComponentRef Id="Cmp_classifier_host" />
      <ComponentRef Id="Cmp_capture_core_run" />
      <ComponentRef Id="Cmp_capture_core_env_example" />
    </Feature>
  </Package>
