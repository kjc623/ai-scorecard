@echo off
rem generated by installer/render.mjs from installer/manifest.mjs - edit the manifest, not this file
rem Source the enrolment profile and exec capture-core with the flags it resolves.
setlocal enableextensions enabledelayedexpansion
set "CONFIG=%SAC_CONFIG_FILE%"
if not defined CONFIG set "CONFIG=C:\ProgramData\ShadowAICapture\capture-core.env"
if not exist "%CONFIG%" (
  echo capture-core-run: configuration file %CONFIG% not found 1>&2
  exit /b 1
)
for /f "usebackq tokens=1,* delims==" %%A in (`findstr /b /v "#" "%CONFIG%"`) do set "%%A=%%B"
set "ARGS="
if defined SAC_TENANT_ID set "ARGS=!ARGS! --tenant-id "!SAC_TENANT_ID!""
if defined SAC_DEVICE_ID set "ARGS=!ARGS! --device-id "!SAC_DEVICE_ID!""
if defined SAC_USER_REF set "ARGS=!ARGS! --user-ref "!SAC_USER_REF!""
if defined SAC_POPULATION set "ARGS=!ARGS! --population "!SAC_POPULATION!""
if defined SAC_SPOOL_DIR set "ARGS=!ARGS! --spool-dir "!SAC_SPOOL_DIR!""
if defined SAC_SPOOL_KEY set "ARGS=!ARGS! --spool-key "!SAC_SPOOL_KEY!""
if defined SAC_SPOOL_BOUNDS set "ARGS=!ARGS! --spool-bounds "!SAC_SPOOL_BOUNDS!""
if defined SAC_RETENTION set "ARGS=!ARGS! --retention "!SAC_RETENTION!""
if defined SAC_HEALTH_FILE set "ARGS=!ARGS! --health-file "!SAC_HEALTH_FILE!""
if defined SAC_BUNDLE set "ARGS=!ARGS! --bundle "!SAC_BUNDLE!""
if defined SAC_POLICY_KEY set "ARGS=!ARGS! --policy-key "!SAC_POLICY_KEY!""
if defined SAC_POLICY_KEY_ID set "ARGS=!ARGS! --policy-key-id "!SAC_POLICY_KEY_ID!""
if defined SAC_CLASSIFIER_ADDRESS set "ARGS=!ARGS! --classifier-address "!SAC_CLASSIFIER_ADDRESS!""
if defined SAC_CLASSIFIER_BUDGET set "ARGS=!ARGS! --classifier-budget "!SAC_CLASSIFIER_BUDGET!""
if defined SAC_PROXY_TLS set "ARGS=!ARGS! --proxy-tls=!SAC_PROXY_TLS!"
if defined SAC_PROXY_TLS_LISTEN set "ARGS=!ARGS! --proxy-tls-listen "!SAC_PROXY_TLS_LISTEN!""
if defined SAC_PROXY_TLS_CANARY set "ARGS=!ARGS! --proxy-tls-canary "!SAC_PROXY_TLS_CANARY!""
if defined SAC_PROXY_LOOPBACK set "ARGS=!ARGS! --proxy-loopback=!SAC_PROXY_LOOPBACK!"
if defined SAC_PROC_DETECT set "ARGS=!ARGS! --proc-detect=!SAC_PROC_DETECT!"
if defined SAC_DRAIN_DEADLINE set "ARGS=!ARGS! --drain-deadline "!SAC_DRAIN_DEADLINE!""
if defined SAC_ATTACHMENT_CAP set "ARGS=!ARGS! --attachment-cap "!SAC_ATTACHMENT_CAP!""
if defined SAC_DEVICE_ENDPOINT set "ARGS=!ARGS! --device-endpoint "!SAC_DEVICE_ENDPOINT!""
if defined SAC_AUTH_MODE set "ARGS=!ARGS! --auth-mode "!SAC_AUTH_MODE!""
if defined SAC_CREDENTIAL_FILE set "ARGS=!ARGS! --credential-file "!SAC_CREDENTIAL_FILE!""
if defined SAC_ENROLMENT_TOKEN set "ARGS=!ARGS! --enrolment-token "!SAC_ENROLMENT_TOKEN!""
if defined SAC_CA_FILE set "ARGS=!ARGS! --ca-file "!SAC_CA_FILE!""
if defined SAC_MDM_ID set "ARGS=!ARGS! --mdm-id "!SAC_MDM_ID!""
if defined SAC_BACKOFF_BASE set "ARGS=!ARGS! --backoff-base "!SAC_BACKOFF_BASE!""
if defined SAC_BACKOFF_CAP set "ARGS=!ARGS! --backoff-cap "!SAC_BACKOFF_CAP!""
if defined SAC_LOG_LEVEL set "ARGS=!ARGS! --log-level "!SAC_LOG_LEVEL!""
if defined SAC_LOG_FORMAT set "ARGS=!ARGS! --log-format "!SAC_LOG_FORMAT!""
"C:\Program Files\ShadowAICapture\bin\capture-core.exe" %ARGS%
exit /b %ERRORLEVEL%
