@echo off
rem generated by installer/render.mjs from installer/manifest.mjs - edit the manifest, not this file
rem Exec capture-core with the vendor file, then the tenant file (the later config-file wins).
setlocal enableextensions
set "CONFIG=%SAC_CONFIG_FILE%"
if not defined CONFIG set "CONFIG=C:\ProgramData\ShadowAICapture\profile\capture-core.env"
set "TENANT=%SAC_TENANT_FILE%"
if not defined TENANT set "TENANT=C:\ProgramData\ShadowAICapture\profile\tenant.env"
if not exist "%CONFIG%" (
  echo capture-core-run: configuration file %CONFIG% not found 1>&2
  exit /b 1
)
if exist "%TENANT%" (
  "C:\Program Files\ShadowAICapture\bin\capture-core.exe" --config-file "%CONFIG%" --config-file "%TENANT%"
) else (
  "C:\Program Files\ShadowAICapture\bin\capture-core.exe" --config-file "%CONFIG%"
)
exit /b %ERRORLEVEL%
