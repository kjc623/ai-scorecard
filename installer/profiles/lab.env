# installer/profiles/lab.env - a development enrolment profile for the local auth lab.
#
# This is a PROFILE, not a secret store: it carries the non-secret coordinates the lab edge uses and
# leaves the enrolment token empty, because the token is single-use and minted per run by
# installer/dev.mjs (or by `localdev/run.mjs --auth`). A development MSI takes a filled-in copy as its
# tenant file, placed beside it:
#
#   pwsh installer/windows/Build-Msi.ps1 -TenantEnv <filled-in copy>
#
# The values are the ones localdev/authlab.compose.yaml serves. `edge` is the in-network hostname;
# a device on the host would use https://localhost:8443 and localdev/.authlab/dev-ca.crt.

SAC_TENANT_ID=11111111-1111-1111-1111-111111111111
SAC_DEVICE_ID=22222222-2222-4222-8222-222222222222
SAC_USER_REF=dev-user
SAC_POPULATION=dev
SAC_SPOOL_BOUNDS=dev
SAC_RETENTION=1h
SAC_PROXY_TLS=false
SAC_PROXY_LOOPBACK=false
SAC_PROC_DETECT=false
SAC_DEVICE_ENDPOINT=https://edge:8443
SAC_AUTH_MODE=x509
SAC_CA_FILE=/authlab/dev-ca.crt
SAC_MDM_ID=sac-dev-installer
SAC_ENROLMENT_TOKEN=
SAC_LOG_LEVEL=debug
