# installer/profiles/lab-host.env - the enrolment profile for an endpoint running ON THE HOST,
# pointed at the local Docker auth lab (not inside the lab network).
#
# The counterpart of profiles/lab.env, which uses the in-network hostname `edge` and the mounted
# `/authlab/dev-ca.crt`. This one uses the host-published edge (`https://127.0.0.1:8443`) and a
# Windows path to the dev CA, because from the host that is what actually resolves and verifies.
# The edge certificate carries DNS names `edge` and `localhost` and IP SANs 127.0.0.1 / ::1, so both
# the name and the address verify against the dev CA.
#
# Use it for a development MSI with:
#   pwsh installer/windows/Build-Msi.ps1 -ConfigFile installer/profiles/lab-host.env
#
# Fill SAC_CA_FILE with your checkout path and SAC_ENROLMENT_TOKEN with `node installer/seed.mjs`.

SAC_TENANT_ID=11111111-1111-1111-1111-111111111111
# Start with this; enrolment mints the server-side device_id, and `capture-core` stamps envelopes
# from --device-id, so this must be replaced by the value ops.device holds before events are sent.
SAC_DEVICE_ID=22222222-2222-4222-8222-222222222222
SAC_USER_REF=dev-user
SAC_POPULATION=dev
SAC_SPOOL_BOUNDS=dev
SAC_RETENTION=1h
SAC_PROXY_TLS=false
SAC_PROXY_LOOPBACK=false
SAC_PROC_DETECT=false
SAC_DEVICE_ENDPOINT=https://127.0.0.1:8443
SAC_AUTH_MODE=x509
SAC_CA_FILE=C:\src\ai-scorecard\localdev\.authlab\dev-ca.crt
SAC_MDM_ID=sac-dev-windows
SAC_ENROLMENT_TOKEN=
SAC_LOG_LEVEL=debug
