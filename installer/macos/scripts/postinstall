#!/bin/sh
# installer/macos/scripts/postinstall - create state, seed the config, load the daemon.
set -eu
STATEDIR=/var/db/shadow-ai-capture
LOGDIR=/var/log/shadow-ai-capture
CONFIGDIR=/usr/local/etc/shadow-ai-capture
LABEL=com.shadowaicapture.capture-core
PLIST="/Library/LaunchDaemons/${LABEL}.plist"

mkdir -p "$STATEDIR" "$LOGDIR" "$CONFIGDIR"
# The state holds the spool and the sealed credential; root-only, like the Linux unit.
chmod 700 "$STATEDIR"
chmod 700 "$LOGDIR"

# Never overwrite an existing profile: an installer that resets a device identity is worse than one
# that stops (docs/05-platform-delivery.md §6.4).
if [ ! -f "$CONFIGDIR/capture-core.env" ] && [ -f "$CONFIGDIR/capture-core.env.example" ]; then
  cp "$CONFIGDIR/capture-core.env.example" "$CONFIGDIR/capture-core.env"
  chmod 600 "$CONFIGDIR/capture-core.env"
fi

# Modern launchctl first, then the legacy verb for older systems.
launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null || true
exit 0
