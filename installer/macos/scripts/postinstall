#!/bin/sh
# postinstall - create the state and log directories, install the tenant file, start the daemon.
set -eu
CONFIGDIR=/usr/local/etc/shadow-ai-capture
PLIST=/Library/LaunchDaemons/com.shadowaicapture.capture-core.plist

# The CLI shim writes into /var/db/shadow-ai-capture for every user to read; the state beneath it
# holds the device credential and the spool, root only.
install -d -m 0755 /var/db/shadow-ai-capture
install -d -m 0700 /var/db/shadow-ai-capture/state /var/log/shadow-ai-capture

# $1 is the package path. A supplied tenant file replaces an installed one; with none, it is kept.
PKG_DIR=$(dirname "${1:-/nonexistent/pkg}")
if [ -f "$PKG_DIR/ShadowAICapture.tenant.env" ]; then
  install -m 0600 "$PKG_DIR/ShadowAICapture.tenant.env" "$CONFIGDIR/tenant.env"
fi

launchctl bootstrap system "$PLIST"
exit 0
