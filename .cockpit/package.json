{
  "name": "dsh-project-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "A visual cockpit for a project built with DeepSeek Harness agents: the architecture map, the live team, the shared task board, and exactly which files each agent is handed.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "schema",
    "cordis.patch.yml",
    "README.md",
    "PROJECT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "check": "node tools/build-client.mjs --check",
    "test": "node test/run.mjs && node test/bundle.mjs && node test/panel.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "architecture",
    "agent-teams",
    "planning"
  ]
}
