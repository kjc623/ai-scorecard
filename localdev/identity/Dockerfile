# The auth lab's identity step: the generated identity material plus the script that stages the
# signing keys and seeds the sample tenant's identity connection (localdev/identity/seed.sh).
#
# An image rather than a bind mount, as for sac/schema:lab and sac/authlab-pki:lab: a build-time COPY
# streams the files through the build context, which works on every daemon. Nothing here is
# committed: localdev/.authlab-identity is generated by `node localdev/build.mjs --auth`.
FROM postgres:17-alpine

COPY localdev/.authlab-identity/ /identity/
COPY localdev/identity/seed.sh /identity/seed.sh

ENTRYPOINT ["sh", "/identity/seed.sh"]
