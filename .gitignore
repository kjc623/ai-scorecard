# Build output and local tool state - never part of the deliverable
.tools/gocache/
.tools/gopath/
.tools/probe/
.tools/tmp/
.tools/shot/
.tools/pg/
.tools/dsh-src/
.tools/asar-extract.mjs
.tools/asar-pick.mjs

# A per-component build cache: some tool invocations default GOCACHE to a .tools directory
# beside the module rather than to the repo root. Regenerable, ~950 files per module, and
# never a deliverable.
**/.tools/gocache/
**/.tools/gopath/

# Extracted DSH SDK packages, kept only as a local reference while building
# .cockpit/. Regenerable from the installed harness's app.asar, and 35 MB of
# third-party files - a backup should not carry a copy of someone else's SDK.
.research/

# Generated preview (regenerate with: node .cockpit/tools/preview.mjs)
cockpit-preview.html

# Local SDK links for the cockpit's test suite
# (regenerate with: node .cockpit/tools/link-sdk.mjs)
.cockpit/node_modules/

# Go
bin/
*.exe
*.test
*.wasm
!device/classifier-host/wasm/*.wasm

# Node
node_modules/
*.log

# Local database cluster state
.tools/pgdata/

# Evidence logs are produced by a run, not authored. The prose that interprets them
# (db/evidence/README.md, .integration/*.md) stays tracked; the raw logs do not, or every
# acceptance run adds thirty files to the repository.
db/evidence/*.log
.integration/verify-all-*.json
.integration/accept-*.json

# Editor / OS
.DS_Store
Thumbs.db

# Selftest work directories: run artifacts, never deliverables. A selftest must leave the tree as
# it found it; this is the belt to that braces, because one of these files is a spool key.
.selftest/
**/.selftest/

# Throwaway scratch space: test runners' temp dir, browser profiles from the in-browser
# checks, and anything else a run needs to write. Never a deliverable - a Chrome profile
# alone is tens of megabytes of cache.
.testtmp/

# The extension's development identity: generated by tools/make-extension-key.mjs, whose public
# half is committed as manifest.json's `key` field. The private half is what would sign a .crx,
# so it is never tracked - the pinned id is reproducible from the committed public key alone.
# Path-anchored patterns, not basenames: a stray copy anywhere else should not be ignored silently.
extension/tools/extension-key.pem
extension/tools/extension-key.pub.der
