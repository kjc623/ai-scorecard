<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by device/installer/render.mjs from device/installer/manifest.mjs; edit the manifest, not this file -->
<!--
  The generic Windows package: code only. The tenant file is not in the package; the MSI copies it at
  install from ShadowAICapture.tenant.env in the folder it runs from, so one signed MSI serves every tenant
  and the install command takes no properties. ProductVersion and StageDir are build variables.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Shadow AI Capture" Manufacturer="Shadow AI Capture" Version="$(var.ProductVersion)"
           UpgradeCode="7E9C2B7A-6D0E-4C6A-9F2B-1A6E6C2D44A1" Scope="perMachine" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Shadow AI Capture is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ShadowAICapture">
        <Directory Id="BINFOLDER" Name="bin" />
        <Directory Id="CLASSIFIERFOLDER" Name="classifier" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="ShadowAICapture">
        <Directory Id="PROFILEFOLDER" Name="profile" />
        <Directory Id="STATEFOLDER" Name="state" />
        <Directory Id="CLIFOLDER" Name="cli" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Product">
      <!-- The agent: a LocalSystem service that reads the vendor file, then the tenant file. -->
      <Component Id="Cmp_CaptureCore" Directory="BINFOLDER">
        <File Id="Fil_CaptureCore" Source="$(var.StageDir)\bin\capture-core.exe" KeyPath="yes">
          <!-- The Start-menu shortcut whose AppUserModelID the agent's notifications are shown under. -->
          <Shortcut Id="Sc_StartMenu" Directory="ProgramMenuFolder" Name="Shadow AI Capture" Description="Shows the notifications of the Shadow AI Capture agent."
                    Arguments="--version" WorkingDirectory="BINFOLDER">
            <ShortcutProperty Key="System.AppUserModel.ID" Value="ShadowAICapture.Agent" />
          </Shortcut>
        </File>
        <ServiceInstall Id="Svc" Name="ShadowAICapture" DisplayName="Shadow AI Capture"
                        Description="Observes AI submissions on this device and sends them to the tenant."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"
                        Arguments="--config-file &quot;[PROFILEFOLDER]capture-core.env&quot; --config-file &quot;[PROFILEFOLDER]tenant.env&quot;" />
        <ServiceControl Id="SvcControl" Name="ShadowAICapture" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <Component Id="Cmp_ClassifierHost" Directory="BINFOLDER">
        <File Id="Fil_ClassifierHost" Source="$(var.StageDir)\bin\classifier-host.exe" KeyPath="yes" />
      </Component>
      <!-- The browser extension's native messaging host, registered for Chrome and Edge. -->
      <Component Id="Cmp_NativeHost" Directory="BINFOLDER">
        <File Id="Fil_NativeHost" Source="$(var.StageDir)\etc\com.shadowaicapture.capture_core.json" KeyPath="yes" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.shadowaicapture.capture_core" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="[#Fil_NativeHost]" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.shadowaicapture.capture_core" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="[#Fil_NativeHost]" />
        </RegistryKey>
      </Component>
      <!-- The installed version, which MDM detection rules compare: it follows the agent's updates. -->
      <Component Id="Cmp_InstalledVersion" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="SOFTWARE\ShadowAICapture" Name="Version" Type="string" Value="[ProductVersion]" KeyPath="yes" />
      </Component>
      <!-- profile and state hold the deployment key, the device credential and the spool: SYSTEM and
           Administrators only. Users may read cli. A component keyed by a folder needs a fixed GUID. -->
      <Component Id="Cmp_DataFolders" Directory="DATAFOLDER" Guid="5B0F5E53-2C0B-4B4B-9E3C-6D7C1C2F9A10">
        <CreateFolder Directory="DATAFOLDER"><PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;;0x1200a9;;;BU)" /></CreateFolder>
        <CreateFolder Directory="PROFILEFOLDER"><PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
        <CreateFolder Directory="STATEFOLDER"><PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" /></CreateFolder>
        <CreateFolder Directory="CLIFOLDER"><PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" /></CreateFolder>
      </Component>
      <!-- The vendor file, and the tenant file copied from the folder the MSI runs from. -->
      <Component Id="Cmp_VendorConfig" Directory="PROFILEFOLDER">
        <File Id="Fil_VendorConfig" Source="$(var.StageDir)\etc\capture-core.env" KeyPath="yes" />
        <CopyFile Id="CopyTenantEnv" SourceProperty="TENANTENV_DIR" SourceName="ShadowAICapture.tenant.env"
                  DestinationDirectory="PROFILEFOLDER" DestinationName="tenant.env" />
      </Component>
      <Files Directory="CLASSIFIERFOLDER" Include="$(var.StageDir)\classifier\**" />
    </ComponentGroup>

    <!--
      The tenant file. ResolveSource sets SourceDir for a first install or a major upgrade only (at a
      removal it would prompt for the source). MoveFiles refuses SourceDir itself as a source folder,
      so it is copied into TENANTENV_DIR. A launch condition cannot test the source folder, so an
      immediate action after costing fails the install, before anything changes, when there is
      neither a tenant file beside the MSI nor one installed. MoveFiles replaces an installed
      tenant.env with a supplied one, and a copied file survives an upgrade.
    -->
    <SetProperty Id="TENANTENV_DIR" Value="[SourceDir]" After="ResolveSource" Sequence="execute" Condition="NOT Installed" />
    <CustomAction Id="CheckTenantConfig" Directory="CommonAppDataFolder" Execute="immediate" Return="check"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /d /c if exist &quot;[TENANTENV_DIR]ShadowAICapture.tenant.env&quot; (exit 0) else if exist &quot;[PROFILEFOLDER]tenant.env&quot; (exit 0) else (echo Shadow AI Capture needs ShadowAICapture.tenant.env beside ShadowAICapture.msi: none was found there and this device has no tenant configuration installed. Download the deployment package from Settings, Deployment and run the MSI from the folder that holds both files. &amp; exit 1)" />
    <!-- Started without waiting and without failing the install: a service that does not start stays
         registered for diagnosis instead of rolling the install back. Output goes to nul so sc.exe
         never waits on a console. -->
    <CustomAction Id="StartService" Directory="CommonAppDataFolder" Execute="deferred" Impersonate="no" Return="asyncNoWait"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c sc.exe start ShadowAICapture &gt;nul 2&gt;&amp;1" />
    <!-- A full uninstall removes the data folder: the spool, the credential, the logs and the copied
         tenant.env are not installed files. An upgrade keeps them. -->
    <CustomAction Id="RemoveData" Directory="CommonAppDataFolder" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]cmd.exe&quot; /c rmdir /s /q &quot;[DATAFOLDER]&quot;" />
    <!-- A full uninstall first puts back what the agent changed outside its own folders: capture-core
         runs as SYSTEM once the service has stopped, while its files are still installed, and logs
         each step to %WINDIR%\Temp\ShadowAICapture-uninstall.log. Its exit code is ignored, so it
         never blocks the uninstall. -->
    <CustomAction Id="UninstallCleanup" FileRef="Fil_CaptureCore" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="--uninstall-cleanup --config-file &quot;[PROFILEFOLDER]capture-core.env&quot; --config-file &quot;[PROFILEFOLDER]tenant.env&quot;" />
    <InstallExecuteSequence>
      <ResolveSource After="CostInitialize" Condition="NOT Installed" />
      <Custom Action="CheckTenantConfig" After="CostFinalize" Condition="NOT Installed" />
      <Custom Action="StartService" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="UninstallCleanup" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveData" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Shadow AI Capture" Level="1">
      <ComponentGroupRef Id="Product" />
    </Feature>
  </Package>
</Wix>
