# generated by device/installer/render.mjs from device/installer/manifest.mjs; edit the manifest, not this file
[Unit]
Description=Shadow AI Capture endpoint agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/shadow-ai-capture/bin/capture-core --config-file /etc/shadow-ai-capture/capture-core.env --config-file /etc/shadow-ai-capture/tenant.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/shadow-ai-capture /etc/shadow-ai-capture -/usr/local/share/ca-certificates -/etc/ssl/certs -/etc/pki/ca-trust -/etc/profile.d
RuntimeDirectory=shadow-ai-capture
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
