#!/bin/sh
# Project Cockpit / Shadow AI Capture - keep the Desktop backup current.
#
# Installed as .git/hooks/post-commit by .tools/git-setup.ps1. Every commit is
# pushed to the `backup` remote, so the folder on the Desktop holds a copy
# without anyone remembering to run anything.
#
# It never blocks a commit: if the backup is unreachable or the push is
# rejected, the commit still stands and the failure is printed. Run
# `.cockpit/tools/git-sync.ps1` (or `git push backup --all`) to catch up.

remote=backup

if ! git remote get-url "$remote" >/dev/null 2>&1; then
  # No backup remote in this clone. Nothing to do, and nothing to complain about.
  exit 0
fi

branch=$(git symbolic-ref --short -q HEAD)

if [ -n "$branch" ]; then
  if ! git push --quiet "$remote" "$branch" 2>&1; then
    echo ""
    echo "  note: the backup at '$remote' was not updated (push failed)."
    echo "        the commit is safe locally; run: git push $remote --all"
    echo ""
  fi
else
  # Detached HEAD: push every branch so nothing is stranded.
  git push --quiet "$remote" --all 2>/dev/null || true
fi

# Tags are cheap and a lost tag is a lost reference point.
git push --quiet "$remote" --tags 2>/dev/null || true

exit 0
